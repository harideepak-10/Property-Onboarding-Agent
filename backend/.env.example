DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onboarding
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Listing nickname sequence starts here (A37331-TOR-...)
NICKNAME_START=37331
DEFAULT_CITY_CODE=TOR

# Procurement
OVER_PRICE_THRESHOLD=0.25
# web = read each product link's page (needs product links in the master list)
# simulated = repeatable fake results; keep this for demos with the sample list
PRICE_CHECKER=simulated

# --- Phase 2: agents (leave blank = dry-run mode) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DELEGATED_ADMIN=
GOOGLE_SENDER_EMAIL=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_TRACKER_SHEET_ID=
GOOGLE_TRACKER_RANGE=Portfolio!A:J
UNIT_EMAIL_DOMAIN=stays.example.com
UNIT_EMAIL_PATTERN={street}{unit}
OPS_EMAIL=ops@stays.example.com
FOLLOWUP_DAYS=5

# --- Phase 3: listings (leave blank = dry-run mode) ---
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
# Public address of this backend (not localhost). Render fills this in automatically.
PUBLIC_BASE_URL=
SERVE_MEDIA=true
ANGEL_HOST_EMAIL=
LISTING_MIN_PHOTOS=5
LISTING_DEFAULT_BASE_PRICE=150

# Password for the demo login created by `seed_demo` (default onboarding2026)
DEMO_PASSWORD=

# --- Phase 5: operations ---
# Utilities that must be active before step 2 counts as done
REQUIRED_UTILITIES=electricity,internet
# Days after a photo shoot before the photographer is chased for the Drive link
PHOTO_FOLLOWUP_DAYS=3
# Daily digest recipient (defaults to OPS_EMAIL) and optional Slack incoming webhook
DIGEST_TO=
SLACK_WEBHOOK_URL=
# Run agents in a background thread (the page polls for progress)
AGENTS_ASYNC=false
